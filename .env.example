# Required: bind address for the HTTP server.
SPOTIFLAC_LISTEN=:8080

# Required: 32+ random bytes used to sign session cookies. Sessions are
# invalidated whenever this value changes. Generate with: openssl rand -hex 32
SPOTIFLAC_COOKIE_SECRET=

# Where the bbolt DBs (users, history, isrc cache) and config live.
# In Docker this is the mounted volume.
SPOTIFLAC_DATA_DIR=./data

# Where per-request temp files (downloaded FLACs being streamed) live.
# Auto-cleaned after SPOTIFLAC_TMP_TTL_MIN minutes (default 60).
SPOTIFLAC_TMP_DIR=/tmp/spotiflac
SPOTIFLAC_TMP_TTL_MIN=60

# Seed the first admin user on initial boot (skipped if the user already exists).
SPOTIFLAC_INITIAL_USER=admin
SPOTIFLAC_INITIAL_PASSWORD=change-me

# Optional: shown in /api/health
SPOTIFLAC_VERSION=dev
